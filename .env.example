# StudyOS Environment Variable Template
# Copy this file to .env and configure credentials for production deployment

# Database Configuration (Neon Cloud PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql://studyos_user:studyos_password@localhost:5432/studyos_db

# JWT Security Credentials
JWT_SECRET=your_jwt_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# AI Agent Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary Storage Credentials (Course materials & document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# CORS & Server Environment
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
